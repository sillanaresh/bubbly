{
  "name": "habibi-float-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute habibi-float-api-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute habibi-float-api-db --remote --file=./schema.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260430.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15",
    "wrangler": "^4.50.0"
  }
}
